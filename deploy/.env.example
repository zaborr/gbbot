# Copy to .env in the repository root: cp deploy/.env.example .env
# NEVER commit the real .env.

# Domain pointing to this server (DNS A/AAAA record). Caddy gets HTTPS for it.
# In @BotFather, set the Mini App URL to https://<DOMAIN>
DOMAIN=gb.example.com

# More domains for customers only, separated by spaces (each needs its DNS record
# pointing to this server): the web for when the bot is down, if the main domain is
# blocked. Admins cannot sign in there. Empty = none.
WEB_DOMAINS=
# false = the message with a customer's web key shows only the WEB_DOMAINS links,
# not the main domain (which still serves the Mini App and the admins).
WEB_KEY_MAIN_LINK=true

# The login bot: "Log in with Telegram" on the web (web accounts link their Telegram,
# sign in, recover a password). A bot of its own, used for nothing else.
# @BotFather → that bot → Login Widget: copy the Client ID and Client Secret, and add
# as Allowed URLs https://<each domain>/api/auth/telegram/callback.
LOGIN_BOT_CLIENT_ID=
LOGIN_BOT_CLIENT_SECRET=

# Web sign-in of admins (password + authenticator code). By default on the main
# domain and the .onion address.
# true = only through the .onion address, for every web account.
WEB_LOGIN_ONION_ONLY=false
# true = full platform accounts only through the .onion address; linked ones
# (supervisors, organisers, GB teams) also on the main domain.
WEB_PLATFORM_ONION_ONLY=false

# Password of the bundled Postgres (any long random string)
POSTGRES_PASSWORD=change-me

# Uncomment to use an external database (e.g. Neon) instead of the bundled one
# DATABASE_URL=postgres://user:password@host/db?sslmode=verify-full

# Telegram bot token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Long random strings: openssl rand -hex 32
JWT_SECRET=change-me
TELEGRAM_WEBHOOK_SECRET=change-me
# Optional: key for the bot tokens kept in the database (derived from
# JWT_SECRET when empty). If set, keep it: without it they cannot be read.
BOTS_KEY=

# Platform admins: comma-separated Telegram user ids
ADMIN_TELEGRAM_IDS=

# Optional: your own blockchain nodes (public ones by default)
# RPC_BASE_URL=
# RPC_ETHEREUM_URL=
# RPC_SOLANA_URL=
