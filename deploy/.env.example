# Copy to .env in the repository root: cp deploy/.env.example .env
# NEVER commit the real .env.

# Domain pointing to this server (DNS A/AAAA record). Caddy gets HTTPS for it.
# In @BotFather, set the Mini App URL to https://<DOMAIN>
DOMAIN=gb.example.com

# Password of the bundled Postgres (any long random string)
POSTGRES_PASSWORD=change-me

# Uncomment to use an external database (e.g. Neon) instead of the bundled one
# DATABASE_URL=postgres://user:password@host/db?sslmode=verify-full

# Telegram bot token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Long random strings: openssl rand -hex 32
JWT_SECRET=change-me
TELEGRAM_WEBHOOK_SECRET=change-me

# Platform admins: comma-separated Telegram user ids
ADMIN_TELEGRAM_IDS=

# Optional: your own blockchain nodes (public ones by default)
# RPC_BASE_URL=
# RPC_ETHEREUM_URL=
# RPC_SOLANA_URL=
