# One domain for everything; Caddy gets and renews the HTTPS certificate.
{$DOMAIN} {
	encode gzip zstd

	# Security headers. No frame blocking: Telegram Web opens the Mini App in an iframe.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# API and Telegram webhook → api container
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /webhook/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Everything else: the Mini App (static files)
	handle {
		reverse_proxy miniapp:80
	}
}

# Internal site for an onion service running on the server (web administration).
# Plain HTTP on a port that only the server itself can reach: the onion service
# already encrypts and authenticates the connection. Not the bot's webhook.
http://:8080 {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /webhook/* {
		respond 404
	}
	handle {
		reverse_proxy miniapp:80
	}
}
