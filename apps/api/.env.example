# --- API configuration (copy to .env for local development) ---

# HTTP port the API listens on
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://tma:tma@localhost:5432/tma_shop

# Telegram bot token (from @BotFather). NEVER commit a real value.
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Secret used to sign session JWTs (any long random string, 16+ characters)
JWT_SECRET=change-me-to-a-long-random-secret

# Session lifetime in seconds (default 1h)
JWT_TTL_SECONDS=3600

# Reject Telegram initData older than this many seconds (replay protection)
INITDATA_MAX_AGE_SECONDS=86400

# Platform admins: comma-separated Telegram user ids
ADMIN_TELEGRAM_IDS=

# Secret Telegram sends with each webhook call. Needed for the bot to answer
# /start and to learn the groups it is added to. Unset = webhook off.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Public URL of this API, to register the webhook at startup.
# Not needed on Render (it provides RENDER_EXTERNAL_URL).
PUBLIC_URL=

# Allowed Mini App origin(s), comma-separated. Use * for local development.
CORS_ORIGIN=*

# Blockchain nodes used to check payments (public ones by default).
# Set your own (Alchemy, Helius, QuickNode…) if a network is slow or limited.
# RPC_BASE_URL=https://mainnet.base.org
# RPC_ETHEREUM_URL=https://ethereum-rpc.publicnode.com
# RPC_SOLANA_URL=https://api.mainnet-beta.solana.com

# Web panel (only through Tor). Address shown to managers when they activate
# their web access in the app; leave it unset to hand it out yourself.
# WEB_ONION_URL=http://example.onion
